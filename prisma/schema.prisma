// ─────────────────────────────────────────────────────────────────────────────
// TeamPay.ar — Schema de dominio (Prisma 7)
//
// ⚠️  Prisma 7: la URL de conexión NO va aquí.
//     CLI  → prisma.config.ts  (lee DATABASE_URL via dotenv)
//     Runtime → src/lib/prisma.ts  (PrismaPg adapter)
//
// Convenciones:
//   • Modelos en inglés (compatibilidad NextAuth + TS idiomático)
//   • Enums en SCREAMING_SNAKE_CASE español (ACTIVA, PENDIENTE, etc.)
//   • Montos en Decimal(12,2) — nunca Float
//   • Toda tabla tiene createdAt / updatedAt
//   • Migraciones: npx prisma migrate dev --name "descripcion-corta"
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ═════════════════════════════════════════════════════════════════════════════
// ENUMS
// ═════════════════════════════════════════════════════════════════════════════

/// Rol global del usuario en la aplicación.
/// La capitana de un equipo es quien tiene ownerId en Team.
enum UserRole {
  CAPITANA
  JUGADORA
}

/// Estado de la jugadora dentro de un equipo.
enum TeamMemberStatus {
  ACTIVA
  INACTIVA
}

/// Tipo de evento que genera obligación de pago.
enum EventType {
  CUOTA     // Cuota mensual
  AMISTOSO  // Partido amistoso
  TORNEO    // Torneo o copa
  OTRO      // Cualquier otro evento con costo
}

/// Categoría de gasto operativo del equipo (RF-36).
enum ExpenseCategory {
  ENTRENADOR
  CANCHA
  ARBITROS
  INDUMENTARIA
  OTRO
}

/// Estado del pago de una jugadora para un evento específico.
enum ParticipantStatus {
  PENDIENTE // No pagó todavía
  PAGO      // Pagó
  EXIMIDA   // La capitana la eximió del pago
}

/// Medio por el que se realizó el pago.
enum MedioPago {
  EFECTIVO
  TRANSFERENCIA
}

/// Estado de la suscripción de un equipo (módulo de super administración).
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
}

/// Plan contratado por el equipo.
enum Plan {
  TRIAL
  BASIC
  PRO
}

// ═════════════════════════════════════════════════════════════════════════════
// AUTH.JS — Modelos requeridos por @auth/prisma-adapter v2
// Referencia: https://authjs.dev/getting-started/adapters/prisma
// ═════════════════════════════════════════════════════════════════════════════

/// Usuario de la aplicación. Base del modelo NextAuth, extendido con rol.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(JUGADORA)
  /// Hash de contraseña (bcrypt). Null para cuentas creadas con Google.
  password      String?
  /// Acceso al panel de super administración (/admin). Se asigna a mano en la
  /// base de datos, nunca desde la UI (RF-51). Sin relación con TeamMember/rol
  /// dentro de un equipo (RNF-13).
  isSuperAdmin  Boolean   @default(false)

  // ── Auth.js relations ──────────────────────────────────────────
  accounts Account[]
  sessions Session[]

  // ── Domain relations ───────────────────────────────────────────
  /// Equipos donde este usuario es capitana (owner)
  ownedTeams        Team[]       @relation("TeamOwner")
  /// Perfiles de jugadora vinculados a este usuario (uno por equipo)
  teamMemberships   TeamMember[]
  /// Pagos que este usuario confirmó/registró
  confirmedPayments Payment[]    @relation("PaymentConfirmedBy")

  // ── Super administración ───────────────────────────────────────
  /// Acciones de super admin realizadas por este usuario (si isSuperAdmin)
  superAdminActions SuperAdminAuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

/// Token de un solo uso para el flujo de "olvidé mi contraseña".
/// Separado de VerificationToken porque ese es interno de Auth.js
/// (verificación de cuenta), no de restablecimiento de contraseña.
model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

// ═════════════════════════════════════════════════════════════════════════════
// DOMAIN — Modelos de negocio
// ═════════════════════════════════════════════════════════════════════════════

// ── Team (Equipo) ─────────────────────────────────────────────────────────────

/// Equipo de fútbol. La capitana es el User referenciado por ownerId.
model Team {
  id          String  @id @default(cuid())
  name        String
  description String?
  logoUrl     String?
  /// Colores propios del equipo (hex, ej: "#dc2626") que sobrescriben el tema
  /// violeta default solo dentro de las páginas de este equipo. Null = sin override.
  primaryColor   String?
  secondaryColor String?
  ownerId     String

  owner    User         @relation("TeamOwner", fields: [ownerId], references: [id])
  members  TeamMember[]
  events   Event[]
  expenses Expense[]
  /// Relación comercial del equipo con el producto (plan, facturación) — RF-54
  subscription Subscription?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── TeamMember (Jugadora) ─────────────────────────────────────────────────────

/// Perfil de una jugadora dentro de un equipo.
/// userId es null si la jugadora aún no se registró en la app.
model TeamMember {
  id          String           @id @default(cuid())
  teamId      String
  name        String
  status      TeamMemberStatus @default(ACTIVA)
  /// Vinculación opcional con un User registrado
  userId      String?
  /// Datos opcionales de la jugadora (RF-13)
  phone       String?
  position    String?
  shirtNumber Int?
  /// Co-capitana — mismos permisos que la capitana principal, excepto borrar equipo
  isCoCapitana Boolean @default(false)

  team                Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user                User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  eventParticipations EventParticipant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId])
  @@index([userId])
}

// ── Event (Evento) ────────────────────────────────────────────────────────────

/// Evento que genera obligación de pago para las jugadoras del equipo.
model Event {
  id              String    @id @default(cuid())
  teamId          String
  name            String
  type            EventType
  /// Monto que debe pagar cada jugadora participante
  amountPerPlayer Decimal   @db.Decimal(12, 2)
  dueDate         DateTime
  /// Fecha de cierre — null = abierto, fecha = cerrado (RF-24)
  closedAt        DateTime?

  team         Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  participants EventParticipant[]
  conceptos    EventConcepto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId])
}

// ── EventConcepto ─────────────────────────────────────────────────────────────

/// Ítem de desglose de costos de un evento (ej: Entrenador $210.000, Cancha $70.000).
/// La suma de los conceptos equivale al monto total del evento.
model EventConcepto {
  id      String  @id @default(cuid())
  eventId String
  nombre  String
  monto   Decimal @db.Decimal(12, 2)
  orden   Int     @default(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

// ── EventParticipant ──────────────────────────────────────────────────────────

/// Registro de la participación (y estado de pago) de una jugadora en un evento.
/// @@unique([eventId, teamMemberId]) garantiza que una jugadora aparezca una sola vez por evento.
model EventParticipant {
  id           String            @id @default(cuid())
  eventId      String
  teamMemberId String
  status       ParticipantStatus @default(PENDIENTE)
  /// Monto personalizado que sobreescribe event.amountPerPlayer (RF-21)
  customAmount Decimal?          @db.Decimal(12, 2)

  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  teamMember TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  /// Un EventParticipant tiene como máximo un Payment
  payment    Payment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, teamMemberId])
  @@index([teamMemberId])
}

// ── Payment (Pago) ────────────────────────────────────────────────────────────

/// Registro del pago de una jugadora para un evento.
/// La relación con EventParticipant es 1-a-1 (@unique en eventParticipantId).
model Payment {
  id                 String   @id @default(cuid())
  eventParticipantId String   @unique
  /// Monto efectivamente pagado (puede diferir del amountPerPlayer del evento)
  amount             Decimal  @db.Decimal(12, 2)
  paidAt             DateTime
  /// URL del comprobante de pago (captura de transferencia, etc.)
  receiptUrl         String?
  /// Null cuando quien confirmó el pago eliminó su cuenta (RF-05)
  confirmedById      String?
  /// Medio de pago (null en pagos registrados antes de esta funcionalidad)
  medioPago          MedioPago?

  eventParticipant EventParticipant @relation(fields: [eventParticipantId], references: [id], onDelete: Cascade)
  confirmedBy      User?            @relation("PaymentConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Expense (Gasto) ───────────────────────────────────────────────────────────

/// Gasto del equipo (entrenador, alquiler de cancha, etc.).
/// No está ligado a un Event específico — es un gasto operativo del equipo.
model Expense {
  id       String          @id @default(cuid())
  teamId   String
  concept  String
  amount   Decimal         @db.Decimal(12, 2)
  /// Nombre o descripción de a quién se le pagó
  paidTo   String
  paidAt   DateTime
  category ExpenseCategory @default(OTRO)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId])
}

// ═════════════════════════════════════════════════════════════════════════════
// SUPER ADMINISTRACIÓN — módulo SaaS (ver SUPERADMIN.md)
//
// Estos modelos son exclusivos de la relación comercial con el equipo-cliente
// (plan, facturación, auditoría). Ningún código de este módulo debe consultar
// TeamMember, Event, Payment o Expense — ver RNF-14/RF-57.
// ═════════════════════════════════════════════════════════════════════════════

// ── Subscription ──────────────────────────────────────────────────────────────

/// Relación comercial de un equipo con el producto. 1:1 con Team — la unidad
/// de facturación es el equipo, no la cuenta de usuaria (ver SUPERADMIN.md).
model Subscription {
  id     String @id @default(cuid())
  teamId String @unique
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  plan   Plan               @default(TRIAL)
  status SubscriptionStatus @default(TRIALING)

  /// Precio mensual en pesos argentinos enteros (sin centavos) — mismo
  /// criterio que formatCurrency() en el resto de la app. Null = todavía no
  /// se cargó un precio (ej. cortesía o plan a definir) — RF-59: esos casos
  /// se muestran aparte, nunca se cuentan como 0 en el MRR.
  priceArs Int?

  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?

  /// Persona de contacto del equipo (no necesariamente la capitana con cuenta)
  contactName  String
  contactEmail String
  contactPhone String?

  /// Datos de facturación — RNF-18: nunca deben aparecer en logs de aplicación
  billingName  String?
  billingTaxId String? // CUIT/CUIL
  billingEmail String?

  /// Notas internas del super admin sobre este equipo (RF-61)
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── SuperAdminAuditLog ────────────────────────────────────────────────────────

/// Log de auditoría de acciones del super admin (RF-58). Solo-append desde la
/// app — RNF-19: ningún endpoint debe exponer un UPDATE ni DELETE sobre esta tabla.
model SuperAdminAuditLog {
  id          String @id @default(cuid())
  adminUserId String
  admin       User   @relation(fields: [adminUserId], references: [id])

  /// Ej: "SUBSCRIPTION_STATUS_CHANGED", "BILLING_INFO_EDITED"
  action String

  /// Id del equipo afectado. Sin relación de Prisma a propósito — este log no
  /// debe poder usarse como puerta de entrada para consultar datos del equipo.
  targetTeamId String

  metadata  Json?
  createdAt DateTime @default(now())

  @@index([adminUserId])
  @@index([targetTeamId])
}
