# ─── Base de datos ────────────────────────────────────────────────────────────
# Formato: postgresql://USUARIO:PASSWORD@HOST:PUERTO/NOMBRE_DB
DATABASE_URL="postgresql://dev:dev@localhost:5432/gestion_equipo"

# ─── Auth.js (NextAuth v5) ────────────────────────────────────────────────────
# Generar con: openssl rand -base64 32
AUTH_SECRET=""

# URL base de la aplicación (sin slash final)
AUTH_URL="http://localhost:3000"

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Obtener en: https://console.cloud.google.com → APIs & Services → Credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── Vercel Blob (subida de archivos) ─────────────────────────────────────────
# Obtener en: Vercel Dashboard → Storage → tu Blob store → pestaña ".env.local"
BLOB_READ_WRITE_TOKEN=""

# ─── Resend (emails transaccionales) ──────────────────────────────────────────
# Obtener en: https://resend.com → API Keys
RESEND_API_KEY=""
EMAIL_FROM=""

# ─── Upstash Redis (rate limiting) ────────────────────────────────────────────
# Obtener en: https://upstash.com → crear una base Redis gratuita → REST API
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""